<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      柔光玻璃风格的三个前提：
        1. 状态栏/导航栏透明 —— 让渐变背景延伸上去，否则顶上一条死板色带
        2. windowLightStatusBar=true —— 浅色背景下状态栏图标必须是深色，否则看不清
        3. windowBackground 给渐变 —— 启动/转场时不至于闪白
    -->
    <style name="Theme.SplashSkip" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@drawable/bg_aurora</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="colorPrimary">@color/brand</item>
    </style>

    <!--
      选中项的胶囊底色。
      Material3 默认用 secondaryContainer（淡紫），跟我们的蓝紫光斑撞色；
      换成半透明白之后，胶囊本身也成了玻璃，跟整套视觉统一。
    -->
    <style name="Widget.SplashSkip.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#4DFFFFFF</item>
    </style>

    <!--
      毛玻璃弹窗的窗口主题。
      关键是三件事：
        1. windowBackground 透明 —— 否则圆角外面会露一圈方形白底，圆角白做
        2. windowNoTitle —— 标题由 GlassDialog 自己画，用同一套排版
        3. windowMinWidth 归零 —— 系统默认强制 65% 最小宽度，会盖掉我们算的 88%
    -->
    <style name="Theme.SplashSkip.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
