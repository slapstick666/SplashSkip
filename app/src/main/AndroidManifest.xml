<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ 通知是运行时权限，学习模式需要它来发起确认 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 可选：引导用户把 App 加入电池优化白名单，降低被系统冻结的概率 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 仅用于拉取规则订阅 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      这里刻意不使用 QUERY_ALL_PACKAGES。
      Android 11+ 的包可见性用 <queries> 声明「我要查带 LAUNCHER 的应用」就够了，
      既满足「列出可配置的 App」这个需求，也不会触发应用商店的敏感权限审查。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SplashSkipApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SplashSkip"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RuleListActivity"
            android:exported="false"
            android:label="@string/title_rules" />

        <activity
            android:name=".ui.LogActivity"
            android:exported="false"
            android:label="@string/title_logs" />

        <activity
            android:name=".ui.SnapshotActivity"
            android:exported="false"
            android:label="@string/title_snapshots" />

    </application>

</manifest>
